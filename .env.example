# ---- Public site metadata ----
NEXT_PUBLIC_SITE_URL=https://avinvestresearch.com
NEXT_PUBLIC_SITE_NAME="AV-INVEST RESEARCH"

# ---- Contact & booking ----
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/your-event-type
NEXT_PUBLIC_CONTACT_EMAIL=avinvestresearch@gmail.com

# ---- Auth (Auth.js v5 / Google OAuth 2.0) ----
AUTH_SECRET=replace-with-strong-random-value-at-least-32-chars
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# ---- Database (Postgres / Neon) placeholder ----
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Stripe (server-side only) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AV_FOUNDATIONS=
STRIPE_PRICE_AV_TRADING_LAB=
STRIPE_PRICE_AV_RESEARCH_CLUB=
STRIPE_PRICE_AV_MARKET_LENS=

# ---- Admin (server-only, Google email CSV, exact match after normalize lower-case/trim) ----
ADMIN_GOOGLE_EMAILS=owner@example.com

# ---- Video provider (optional - Bunny Stream boundary) ----
# Configurare per playback protetto. Senza queste env, il player mostra stato non configurato onesto.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=

# ---- Private storage (optional - Research Club PDF) ----
# Scegli UNO dei seguenti storage provider. Nessuna configurazione = upload rifiutato con messaggio onesto.
# Vercel Blob (consigliato se deploy su Vercel):
BLOB_READ_WRITE_TOKEN=
# Bunny Storage (alternativa):
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_REGION=
# AWS S3 (alternativa):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ---- Email (Resend) placeholder ----
RESEND_API_KEY=
GOOGLE_SITE_VERIFICATION=
