generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum PurchaseStatus {
  pending
  succeeded
  failed
  refunded
}

enum VideoSourceType {
  YOUTUBE
  BUNNY_STREAM
  NONE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum StorageProvider {
  BUNNY_STORAGE
  S3
  VERCEL_BLOB
  NONE
}

enum SubscriptionProduct {
  AV_RESEARCH_CLUB
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  ENDED
}

enum ManualGrantKind {
  PAID_VERIFIED
  COMPLIMENTARY
}

enum ManualGrantStatus {
  ACTIVE
  REVOKED
}

enum ManualGrantEvidenceType {
  STRIPE_CHECKOUT_SESSION
  STRIPE_PAYMENT_INTENT
  STRIPE_INVOICE
  OFF_PLATFORM
}

enum ManualGrantConsentSource {
  STRIPE_METADATA
  ADMIN_ATTESTATION
  NONE
}

enum ManualGrantAuditAction {
  CREATED
  REVOKED
  REACTIVATED
  EVIDENCE_RECHECKED
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique @db.VarChar(255)
  googleId       String?          @unique @db.VarChar(255)
  name           String?          @db.VarChar(255)
  image          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchases      Purchase[]
  lessonProgress LessonProgress[]
  subscriptions  Subscription[]
}

model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @db.VarChar(255)
  type        String   @db.VarChar(128)
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([eventId])
}

model Purchase {
  id                         String         @id @default(cuid())
  userEmail                  String         @db.VarChar(255)
  productSlug                String         @db.VarChar(64)
  checkoutSessionId         String         @unique @db.VarChar(255)
  customerId                 String?        @db.VarChar(255)
  paymentIntentId           String?        @unique @db.VarChar(255)
  invoiceId                  String?        @db.VarChar(255)
  amountTotal                Int
  currency                   String         @default("EUR") @db.VarChar(8)
  status                     PurchaseStatus @default(pending)
  purchasedAt                DateTime?
  refundedAt                 DateTime?
  refundedAmount             Int?           @default(0)
  invoiceHostedUrl          String?        @db.Text
  invoicePdfUrl             String?        @db.Text
  consentTermsVersion        String?        @db.VarChar(32)
  consentDigitalWithdrawalVersion String?   @db.VarChar(32)
  consentAcceptedAt          DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  user                       User?          @relation(fields: [userEmail], references: [email])

  @@index([userEmail, status])
  @@index([paymentIntentId])
  @@index([productSlug])
}

model Subscription {
  id                 String              @id @default(cuid())
  userEmail          String              @db.VarChar(255)
  product            SubscriptionProduct @default(AV_RESEARCH_CLUB)
  stripeCustomerId   String?             @db.VarChar(255)
  stripeSubscriptionId String           @unique @db.VarChar(255)
  stripePriceId      String?             @db.VarChar(255)
  status             SubscriptionStatus  @default(INCOMPLETE)
  cancelAtPeriodEnd  Boolean             @default(false)
  currentPeriodEnd   DateTime?
  latestInvoicePaidAt DateTime?
  paymentProblem     Boolean             @default(false)
  paymentProblemAt   DateTime?
  consentTermsVersion String?            @db.VarChar(32)
  consentAcceptedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User?               @relation(fields: [userEmail], references: [email])

  @@unique([userEmail, product])
  @@index([userEmail, product, status])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(64)
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]

  @@index([order])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  slug        String   @db.VarChar(64)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  slug            String           @db.VarChar(128)
  title           String           @db.VarChar(255)
  description     String?          @db.Text
  durationMin     Int?
  videoSourceType VideoSourceType  @default(NONE)
  youtubeVideoId  String?          @db.VarChar(128)
  bunnyVideoId    String?          @db.VarChar(128)
  bunnyLibraryId  String?          @db.VarChar(128)
  status          ContentStatus    @default(DRAFT)
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
  @@index([status])
}

model LessonProgress {
  id              String   @id @default(cuid())
  userEmail       String   @db.VarChar(255)
  lessonId        String
  progressPct     Int      @default(0)
  lastPositionSec Int      @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  lastWatchedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userEmail, lessonId])
  @@index([userEmail])
  @@index([lessonId, completed])
}

model ResearchDoc {
  id              String          @id @default(cuid())
  slug            String          @unique @db.VarChar(128)
  title           String          @db.VarChar(255)
  description     String?         @db.Text
  publicationDate DateTime?
  publishedAt     DateTime?
  storageProvider StorageProvider @default(NONE)
  storageObjectKey String?        @db.VarChar(512)
  storageBucket   String?         @db.VarChar(255)
  pdfFileName     String?         @db.VarChar(255)
  pdfFileSizeBytes Int?
  status          ContentStatus   @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, publicationDate(sort: Desc)])
}

model DownloadRateLimitBucket {
  id                String   @id @default(cuid())
  userEmail         String   @db.VarChar(255)
  scope             String   @db.VarChar(64)
  resourceKey       String   @db.VarChar(256)
  windowStart       DateTime
  windowSizeMinutes Int
  count             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userEmail, scope, resourceKey, windowStart, windowSizeMinutes], name: "RateLimitBucket_unique_key")
  @@index([userEmail, scope])
  @@index([windowStart])
}

/// Accesso attribuito manualmente da un amministratore.
/// Indipendente da Purchase: nessuna relazione Prisma, riferimenti "by value".
/// Nessuna FK su User: il grant può precedere il primo accesso del destinatario.
model ManualGrant {
  id          String            @id @default(cuid())
  userEmail   String            @db.VarChar(255)
  productSlug String            @db.VarChar(64)
  kind        ManualGrantKind
  status      ManualGrantStatus @default(ACTIVE)
  /// "email:slug" quando lo stato è ACTIVE, NULL quando revocato. Garantisce un solo grant attivo per utente+prodotto.
  activeKey   String?           @unique @db.VarChar(400)
  /// "tipo:riferimento" o "PI:<id>" quando il pagamento è verificato. Permane anche dopo la revoca per impedire il riuso della stessa evidenza.
  evidenceKey String?           @unique @db.VarChar(400)

  evidenceType          ManualGrantEvidenceType?
  evidenceReference     String?                 @db.VarChar(255)
  linkedPurchaseId      String?                 @db.VarChar(255)
  evidenceAmountTotal   Int?
  evidenceCurrency      String?                 @db.VarChar(8)
  evidencePaidAt        DateTime?
  evidenceCustomerEmail String?                 @db.VarChar(255)
  evidenceSnapshot      Json?
  evidenceWarnings      Json?
  verifiedAt            DateTime?
  verifiedBy            String?                 @db.VarChar(255)

  consentSource                   ManualGrantConsentSource @default(NONE)
  consentTermsVersion             String?                 @db.VarChar(32)
  consentDigitalWithdrawalVersion String?                 @db.VarChar(32)
  consentAcceptedAt               DateTime?

  grantedBy    String   @db.VarChar(255)
  grantedAt    DateTime @default(now())
  reason       String?  @db.VarChar(64)
  reasonNote   String?  @db.Text
  adminNote    String?  @db.Text
  revokedAt    DateTime?
  revokedBy    String?  @db.VarChar(255)
  revokeReason String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       ManualGrantEvent[]

  @@index([userEmail, productSlug, status])
  @@index([productSlug, status])
  @@index([kind, status])
  @@index([status, grantedAt])
}

/// Registro di audit append-only delle azioni sugli accessi manuali.
model ManualGrantEvent {
  id          String                 @id @default(cuid())
  grantId     String?
  action      ManualGrantAuditAction
  actorEmail  String                 @db.VarChar(255)
  targetEmail String                 @db.VarChar(255)
  productSlug String                 @db.VarChar(64)
  kind        ManualGrantKind?
  detail      Json?
  createdAt   DateTime               @default(now())
  grant       ManualGrant?           @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([grantId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([targetEmail, createdAt])
  @@index([action, createdAt])
}
